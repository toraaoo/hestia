# Shared look for every Hestia demo tape. Source it with `Source common.tape`.
#
# The demos run against ~/.hestia-demo, not a real data home — see the README
# in this directory for the recording recipe.

Set Shell bash
Set FontSize 16
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set Width 1100
Set Height 620
Set Padding 24
Set Margin 0
Set TypingSpeed 45ms
Set PlaybackSpeed 1

Set Theme { "name": "hestia", "background": "#0b0b0d", "foreground": "#e6e6e6", "black": "#0b0b0d", "red": "#e05252", "green": "#8fbf6f", "yellow": "#e8a33d", "blue": "#6f9fd8", "magenta": "#b98ad1", "cyan": "#63b6b0", "white": "#e6e6e6", "brightBlack": "#6a6a72", "brightRed": "#ef6b6b", "brightGreen": "#a6d489", "brightYellow": "#f0b95c", "brightBlue": "#8ab6e6", "brightMagenta": "#cba3e0", "brightCyan": "#7fcac4", "brightWhite": "#ffffff", "selection": "#33333a", "cursor": "#e8873d" }
